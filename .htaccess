Options -Indexes -MultiViews
RedirectMatch 404 "(?i)/(?:\.git|\.github|\.claude|\.codex|\.agents|\.tmp|scripts|tests)(?:/|$)"
<FilesMatch "(^\.|\.(?:sqlite|sql|log|bak|env|py|md)$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Public game URLs. Only browser requests to old HTML URLs are redirected.
RewriteEngine On
RewriteBase /
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/nederland\-topografie\-provincie\-selectiespel\.html$ /spellen/provincie-klik/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/nederland\-topografie\-provincie\-schrijfspel\.html$ /spellen/provincie-schrijf/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/atlascode\-avontuur\-3d\.html$ /spellen/atlascode/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-landen\-klikspel\-3d\.html$ /spellen/europa-landen-klik/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-landen\-schrijfspel\-3d\.html$ /spellen/europa-landen-schrijf/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-hoofdsteden\-klikspel\-3d\.html$ /spellen/europa-hoofdsteden-klik/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-hoofdsteden\-schrijfspel\-3d\.html$ /spellen/europa-hoofdsteden-schrijf/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-raster\-landen\-3d\.html$ /spellen/europa-raster-landen/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/topo/europa\-raster\-hoofdsteden\-3d\.html$ /spellen/europa-raster-hoofdsteden/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/rekenen/rekenen\-race\.html$ /spellen/reken-race/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/rekenen/rekencraft\.html$ /spellen/rekencraft/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+games/" [NC]
RewriteRule ^games/rekenen/getallenzee\.html$ /spellen/getallenzee/ [R=301,L]

# Normalize the trailing slash before serving the underlying file.
RewriteRule ^spellen/(provincie-klik|provincie-schrijf|atlascode|europa-landen-klik|europa-landen-schrijf|europa-hoofdsteden-klik|europa-hoofdsteden-schrijf|europa-raster-landen|europa-raster-hoofdsteden|reken-race|rekencraft|getallenzee)$ /spellen/$1/ [R=301,L]


# Real game directories serve their PHP entry point without an internal rewrite.
DirectoryIndex index.php index.html
